# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives new leads (quote requests, consultations, brochure requests)
CONTACT_RECEIVER_EMAIL=

# Optional: sender address for all emails. Leave unset to use Resend's test sender
# (onboarding@resend.dev), which can ONLY deliver to your own Resend account email.
# To send confirmation emails to customers, verify a domain in Resend and set e.g.:
# RESEND_FROM_EMAIL=orders@yourdomain.com
RESEND_FROM_EMAIL=
